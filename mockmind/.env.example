# LiveKit Cloud credentials (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key

# Cartesia API key (https://play.cartesia.ai/keys)
CARTESIA_API_KEY=your_cartesia_api_key

# Soniox API key (https://console.soniox.com)
SONIOX_API_KEY=your_soniox_api_key

# Redis
REDIS_URL=redis://localhost:6379

# Piston (self-hosted sandboxed code execution, for live-coding questions)
PISTON_URL=http://localhost:2000

# Backend CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Langfuse (self-hosted, observability) ──────────────────────────────
# Optional — the app runs fine without any of this. Powers LLM call tracing.
# These are keys INTO your own self-hosted Langfuse (see docker-compose.yml),
# not a third-party signup. Generate your own values before running:
#   openssl rand -hex 32   -> LANGFUSE_ENCRYPTION_KEY
#   openssl rand -hex 16   -> the rest (SALT, passwords, PROJECT_SECRET_KEY)
# LANGFUSE_HOST is what the backend/agent SDKs connect to.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me

# Infra-only secrets used by the langfuse-* services in docker-compose.yml.
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=change-me-64-hex-chars
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_POSTGRES_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_AUTH=change-me
LANGFUSE_MINIO_ROOT_PASSWORD=change-me
LANGFUSE_INIT_USER_EMAIL=admin@mockmind.local
LANGFUSE_INIT_USER_PASSWORD=change-me
